{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "booking-system-web-non-production",
  "main": "./src/nonProductionWorker.js",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BETTER_AUTH_SECRET": "local-e2e-only-not-a-production-secret-value",
    "GOOGLE_CLIENT_ID": "local-e2e-google-client-id-not-a-real-credential",
    "GOOGLE_CLIENT_SECRET": "local-e2e-google-client-secret-not-a-real-credential",
    "BOOKING_TEST_NOW": "2026-08-28T10:00:00.000Z"
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "booking-system-local",
      "database_id": "booking-system-local",
      "migrations_dir": "migrations"
    }
  ]
}
